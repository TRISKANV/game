    <string name="story_wake_1">¿Qué hora es...?</string>
    <string name="story_wake_2">Otra noche sin dormir.</string>
    <string name="story_obj_computer">Tengo demasiadas cosas abiertas... debería ordenar esto algún día.</string>
    <string name="story_obj_desk">Café frío, cables por todas partes... lo de siempre.</string>
